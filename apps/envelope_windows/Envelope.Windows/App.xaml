<Application x:Class="Envelope.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Envelope.Windows.ViewModels"
             xmlns:views="clr-namespace:Envelope.Windows.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Themes/Light.xaml" />
                <ResourceDictionary Source="Resources/Strings.zh-CN.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                <views:AboutPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ContactsViewModel}">
                <views:ContactsPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ChatViewModel}">
                <views:ChatPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UnsealViewModel}">
                <views:UnsealPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsPage />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
