    <sys:String x:Key="About.Title">关于 Envelope</sys:String>
    <sys:String x:Key="About.Subtitle">版本、签名、安全边界与使用帮助</sys:String>
    <sys:String x:Key="About.HeroTitle">把重要内容放进只有收件人能打开的信封。</sys:String>
    <sys:String x:Key="About.HeroText">Envelope 在本机完成身份、加密和签名。在线聊天、群组与离线信封采用同一套可验证身份，让外部通道只负责搬运密文。</sys:String>
    <sys:String x:Key="About.SecurityBadge">端到端加密 · 本地优先</sys:String>
    <sys:String x:Key="About.Version">版本</sys:String>
    <sys:String x:Key="About.Build">构建</sys:String>
    <sys:String x:Key="About.Platform">平台</sys:String>
    <sys:String x:Key="About.PlatformValue">Windows · WPF · .NET 8</sys:String>
    <sys:String x:Key="About.Signing">可执行文件 SHA-256</sys:String>
    <sys:String x:Key="About.SigningPending">无法读取可执行文件哈希</sys:String>
    <sys:String x:Key="About.HelpTitle">帮助</sys:String>
    <sys:String x:Key="About.HelpText">查看身份恢复、联系人验证、消息与文件、群组、密封和拆封的完整说明。</sys:String>
    <sys:String x:Key="About.OpenManual">用户手册</sys:String>
