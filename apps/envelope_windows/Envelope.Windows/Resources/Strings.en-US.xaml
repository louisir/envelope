    <sys:String x:Key="About.Title">About Envelope</sys:String>
    <sys:String x:Key="About.Subtitle">Version, signing, security boundaries, and help</sys:String>
    <sys:String x:Key="About.HeroTitle">Put what matters in an envelope only its recipient can open.</sys:String>
    <sys:String x:Key="About.HeroText">Envelope creates identities, encrypts, and signs locally. Chats, groups, and offline envelopes share one verifiable identity while external channels carry ciphertext only.</sys:String>
    <sys:String x:Key="About.SecurityBadge">End-to-end encrypted · local first</sys:String>
    <sys:String x:Key="About.Version">Version</sys:String>
    <sys:String x:Key="About.Build">Build</sys:String>
