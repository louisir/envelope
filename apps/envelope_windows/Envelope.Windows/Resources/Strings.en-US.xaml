    <sys:String x:Key="About.SigningPending">Executable hash unavailable</sys:String>
    <sys:String x:Key="About.HelpTitle">Help</sys:String>
    <sys:String x:Key="About.HelpText">Read the complete guide to identity recovery, contact verification, messages, files, groups, sealing, and opening.</sys:String>
