<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Window">#FFFFF7ED</Color>
    <Color x:Key="Color.Surface">#FFFFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#FFFFFBF5</Color>
    <Color x:Key="Color.SurfaceRaised">#FFFFFFFF</Color>
    <Color x:Key="Color.Sidebar">#FFFFF7ED</Color>
    <Color x:Key="Color.SidebarHover">#FFFFF1E0</Color>
    <Color x:Key="Color.SidebarSelected">#FFFFEDD5</Color>
    <Color x:Key="Color.SidebarText">#FF65716D</Color>
    <Color x:Key="Color.SidebarMuted">#FF8A9792</Color>
    <Color x:Key="Color.Text">#FF24150F</Color>
    <Color x:Key="Color.TextMuted">#FF65716D</Color>
    <Color x:Key="Color.TextSubtle">#FF8A9792</Color>
    <Color x:Key="Color.Border">#FFD9E2DE</Color>
    <Color x:Key="Color.BorderStrong">#FFCFD8D4</Color>
    <Color x:Key="Color.Accent">#FF9A4600</Color>
    <Color x:Key="Color.AccentHover">#FF7D3700</Color>
    <Color x:Key="Color.AccentSoft">#FFFFEDD5</Color>
    <Color x:Key="Color.AccentText">#FFFFFFFF</Color>
    <Color x:Key="Color.Warning">#FFB16A12</Color>
    <Color x:Key="Color.WarningSoft">#FFFFF0D7</Color>
    <Color x:Key="Color.Danger">#FFB53A3A</Color>
    <Color x:Key="Color.DangerSoft">#FFFFE7E7</Color>
    <Color x:Key="Color.Success">#FF24785F</Color>
    <Color x:Key="Color.SuccessSoft">#FFE0F4EB</Color>
    <Color x:Key="Color.MessageMine">#FFEAF2EF</Color>
    <Color x:Key="Color.MessageOther">#FFFFFFFF</Color>
    <Color x:Key="Color.Shadow">#240B211B</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="{StaticResource Color.SidebarHover}" />
    <SolidColorBrush x:Key="Brush.SidebarSelected" Color="{StaticResource Color.SidebarSelected}" />
    <SolidColorBrush x:Key="Brush.SidebarText" Color="{StaticResource Color.SidebarText}" />
    <SolidColorBrush x:Key="Brush.SidebarMuted" Color="{StaticResource Color.SidebarMuted}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextSubtle" Color="{StaticResource Color.TextSubtle}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="{StaticResource Color.WarningSoft}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.SuccessSoft}" />
    <SolidColorBrush x:Key="Brush.MessageMine" Color="{StaticResource Color.MessageMine}" />
    <SolidColorBrush x:Key="Brush.MessageOther" Color="{StaticResource Color.MessageOther}" />
    <SolidColorBrush x:Key="Brush.Shadow" Color="{StaticResource Color.Shadow}" />
    <SolidColorBrush x:Key="Brush.Brand" Color="#FFF97316" />
</ResourceDictionary>
