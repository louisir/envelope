<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Window">#FF101513</Color>
    <Color x:Key="Color.Surface">#FF171D1A</Color>
    <Color x:Key="Color.SurfaceAlt">#FF1C2420</Color>
    <Color x:Key="Color.SurfaceRaised">#FF202925</Color>
    <Color x:Key="Color.Sidebar">#FF0A1512</Color>
    <Color x:Key="Color.SidebarHover">#FF17312A</Color>
    <Color x:Key="Color.SidebarSelected">#FF21463C</Color>
    <Color x:Key="Color.SidebarText">#FFE8F3EF</Color>
    <Color x:Key="Color.SidebarMuted">#FF91AAA2</Color>
    <Color x:Key="Color.Text">#FFE9F0ED</Color>
    <Color x:Key="Color.TextMuted">#FFACBAB5</Color>
    <Color x:Key="Color.TextSubtle">#FF82918C</Color>
    <Color x:Key="Color.Border">#FF33413B</Color>
    <Color x:Key="Color.BorderStrong">#FF475A53</Color>
    <Color x:Key="Color.Accent">#FF43B998</Color>
    <Color x:Key="Color.AccentHover">#FF58C9A8</Color>
    <Color x:Key="Color.AccentSoft">#FF1B3C33</Color>
    <Color x:Key="Color.AccentText">#FF07130F</Color>
    <Color x:Key="Color.Warning">#FFF0B65D</Color>
    <Color x:Key="Color.WarningSoft">#FF493416</Color>
    <Color x:Key="Color.Danger">#FFFF8585</Color>
    <Color x:Key="Color.DangerSoft">#FF4B2424</Color>
    <Color x:Key="Color.Success">#FF59C79F</Color>
    <Color x:Key="Color.SuccessSoft">#FF183E32</Color>
    <Color x:Key="Color.MessageMine">#FF216F5C</Color>
    <Color x:Key="Color.MessageOther">#FF202925</Color>
    <Color x:Key="Color.Shadow">#66000000</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="{StaticResource Color.SidebarHover}" />
    <SolidColorBrush x:Key="Brush.SidebarSelected" Color="{StaticResource Color.SidebarSelected}" />
    <SolidColorBrush x:Key="Brush.SidebarText" Color="{StaticResource Color.SidebarText}" />
    <SolidColorBrush x:Key="Brush.SidebarMuted" Color="{StaticResource Color.SidebarMuted}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextSubtle" Color="{StaticResource Color.TextSubtle}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="{StaticResource Color.WarningSoft}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.SuccessSoft}" />
    <SolidColorBrush x:Key="Brush.MessageMine" Color="{StaticResource Color.MessageMine}" />
    <SolidColorBrush x:Key="Brush.MessageOther" Color="{StaticResource Color.MessageOther}" />
    <SolidColorBrush x:Key="Brush.Shadow" Color="{StaticResource Color.Shadow}" />
</ResourceDictionary>
