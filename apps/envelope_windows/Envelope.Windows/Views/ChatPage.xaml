<UserControl x:Class="Envelope.Windows.Views.ChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Envelope.Windows.Models"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="24,26,24,18">
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="{DynamicResource Chat.Title}" />
                    <TextBlock Style="{StaticResource Text.PageSubtitle}" Text="{DynamicResource Chat.Subtitle}" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="18,0,18,14">
                    <TextBlock Margin="13,0,0,0"
                               VerticalAlignment="Center"
                               Panel.ZIndex="1"
                               FontFamily="Segoe Fluent Icons"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               IsHitTestVisible="False"
                               Text="&#xE721;" />
                    <TextBox Style="{StaticResource TextBox.Search}"
                             Tag="{DynamicResource Chat.Search}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource Chat.Search}" />
                </Grid>
                <Grid Grid.Row="2">
                    <ListBox ItemsSource="{Binding VisibleConversations}"
                             SelectedItem="{Binding SelectedConversation, Mode=TwoWay}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="8,3" />
                                <Setter Property="Padding" Value="11" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Item"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="Transparent"
                                                    CornerRadius="10">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Item" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Item" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Avatar}">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Accent}"
                                                   Text="{Binding Initials}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="2,0,6,0">
                                        <TextBlock FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   Text="{Binding Preview}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource Brush.TextSubtle}"
                                                   Text="{Binding LastActivity, StringFormat={}{0:t}}" />
                                        <Border MinWidth="20"
                                                Height="20"
                                                Margin="0,6,0,0"
                                                Padding="5,0"
                                                HorizontalAlignment="Right"
                                                Background="{DynamicResource Brush.Accent}"
                                                CornerRadius="10">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource Brush.AccentText}"
                                                       Text="{Binding UnreadCount}" />
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UnreadCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasConversations}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock HorizontalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="32"
                                   Foreground="{DynamicResource Brush.TextSubtle}"
                                   Text="&#xE8BD;" />
                        <TextBlock Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Chat.NoConversations}" />
                        <TextBlock MaxWidth="240"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="{DynamicResource Chat.NoConversationsText}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Margin="0,15,0,0"
                                Command="{Binding OpenContactsCommand}"
                                Content="{DynamicResource Chat.OpenContacts}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="68" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="21,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding SelectedConversation.DisplayName}" />
                                <TextBlock Margin="8,1,0,0"
                                           FontFamily="Segoe Fluent Icons"
                                           Foreground="{DynamicResource Brush.Success}"
                                           Text="&#xE73E;">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedConversation.IsVerified}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           FontSize="10"
                                           Foreground="{DynamicResource Brush.Accent}"
                                           Text="&#xE72E;" />
                                <TextBlock Margin="5,0,0,0"
                                           FontSize="10"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           Text="{DynamicResource Chat.EncryptedNotice}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button Margin="0,0,7,0"
                                    Command="{Binding ManageGroupCommand}"
                                    Content="{DynamicResource Chat.ManageGroup}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedConversation.IsGroup}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Margin="0,0,7,0"
                                    Command="{Binding LeaveGroupCommand}"
                                    Content="{DynamicResource Chat.LeaveGroup}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Danger}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedConversation.IsGroup}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Margin="0,0,7,0"
                                    Command="{Binding SealCommand}"
                                    Content="&#xE72E;"
                                    Style="{StaticResource Button.Icon}"
                                    ToolTip="{DynamicResource Chat.Seal}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Margin="22,14,22,2"
                            Padding="14"
                            Background="{DynamicResource Brush.WarningSoft}"
                            BorderBrush="{DynamicResource Brush.Warning}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Warning}"
                                           Text="{DynamicResource Chat.InvitationTitle}" />
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               Text="{DynamicResource Chat.InvitationText}" />
                                    <TextBlock Margin="6,0,0,0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedConversation.PendingGroupInvitationName}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0" Orientation="Horizontal">
                                <Button Margin="0,0,7,0"
                                        Command="{Binding DeclineInvitationCommand}"
                                        Content="{DynamicResource Chat.DeclineInvitation}" />
                                <Button Command="{Binding AcceptInvitationCommand}"
                                        Content="{DynamicResource Chat.AcceptInvitation}"
                                        Style="{StaticResource Button.Primary}" />
                            </StackPanel>
                        </Grid>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedConversation.HasPendingGroupInvitation}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <ListBox x:Name="MessageList"
                             Grid.Row="1"
                             Padding="22,58,22,16"
                             ItemsSource="{Binding Messages}"
                             SelectionMode="Extended"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Focusable" Value="True" />
                                <Setter Property="Margin" Value="0,4" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Border x:Name="Bubble"
                                            MaxWidth="520"
                                            Padding="13,10"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource Brush.MessageOther}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <StackPanel>
                                            <TextBlock x:Name="MessageText"
                                                       FontSize="13"
                                                       LineHeight="19"
                                                       Text="{Binding Text}"
                                                       TextWrapping="Wrap" />
                                            <Button Margin="0,8,0,0"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{DynamicResource Chat.OpenAttachment}">
                                                <Border Padding="10,8"
                                                        Background="{DynamicResource Brush.SurfaceAlt}"
                                                        BorderBrush="{DynamicResource Brush.Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE8A5;" />
                                                        <TextBlock Grid.Column="1" FontSize="11" Text="{Binding AttachmentName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2"
                                                                   Margin="12,0,0,0"
                                                                   FontFamily="Segoe Fluent Icons"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource Brush.Accent}"
                                                                   Text="&#xE8A7;" />
                                                    </Grid>
                                                </Border>
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Quiet}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAttachment}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <StackPanel Margin="0,7,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                                <TextBlock x:Name="MessageTime"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource Brush.TextSubtle}"
                                                           Text="{Binding Timestamp, StringFormat={}{0:t}}" />
                                                <TextBlock x:Name="DeliveryGlyph"
                                                           Margin="5,0,0,0"
                                                           FontFamily="Segoe Fluent Icons"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource Brush.TextSubtle}"
                                                           Text="&#xE73E;" />
                                                <Button Width="24"
                                                        Height="20"
                                                        Margin="6,-4,-6,-4"
                                                        Padding="0"
                                                        Command="{Binding DataContext.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Content="&#xE74D;"
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="9"
                                                        Style="{StaticResource Button.Quiet}"
                                                        ToolTip="{DynamicResource Common.Delete}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Direction}" Value="{x:Static models:MessageDirection.Outgoing}">
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource Brush.MessageMine}" />
                                        <Setter TargetName="Bubble" Property="BorderBrush" Value="{DynamicResource Brush.MessageMine}" />
                                        <Setter TargetName="MessageText" Property="Foreground" Value="White" />
                                        <Setter TargetName="MessageTime" Property="Foreground" Value="#FFD8EEE7" />
                                        <Setter TargetName="DeliveryGlyph" Property="Foreground" Value="#FFD8EEE7" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Direction}" Value="{x:Static models:MessageDirection.Incoming}">
                                        <Setter TargetName="DeliveryGlyph" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1"
                                Margin="22,12,22,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Orientation="Horizontal"
                                Panel.ZIndex="2">
                        <Button Margin="0,0,8,0"
                                Command="{Binding LoadEarlierMessagesCommand}"
                                Content="{DynamicResource Chat.LoadEarlier}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Quiet}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasEarlierMessages}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding DeleteSelectedMessagesCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=MessageList}"
                                Content="{DynamicResource Chat.DeleteSelected}"
                                Style="{StaticResource Button.Quiet}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasSelection}" Value="True" />
                                            <Condition Binding="{Binding Messages.Count}" Value="0" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock HorizontalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="34"
                                   Foreground="{DynamicResource Brush.TextSubtle}"
                                   Text="&#xE8BD;" />
                        <TextBlock Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Chat.NoMessages}" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="{DynamicResource Chat.NoMessagesText}" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        Padding="18,13,18,17"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Margin="0,0,9,0"
                                Command="{Binding AttachFileCommand}"
                                Content="&#xE898;"
                                Style="{StaticResource Button.Icon}"
                                ToolTip="{DynamicResource Chat.AttachFile}" />
                        <TextBox x:Name="Composer"
                                 Grid.Column="1"
                                 MinHeight="42"
                                 MaxHeight="120"
                                 AcceptsReturn="True"
                                 IsEnabled="{Binding HasSelection}"
                                 PreviewKeyDown="Composer_PreviewKeyDown"
                                 Tag="{DynamicResource Chat.MessagePlaceholder}"
                                 Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 ToolTip="{DynamicResource Chat.MessagePlaceholder}"
                                 VerticalScrollBarVisibility="Auto" />
                        <Button Grid.Column="2"
                                MinWidth="82"
                                Margin="9,0,0,0"
                                Command="{Binding SendCommand}"
                                Style="{StaticResource Button.Primary}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,7,0" FontFamily="Segoe Fluent Icons" Text="&#xE724;" />
                                <TextBlock Text="{DynamicResource Chat.Send}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.RowSpan="3" Background="{DynamicResource Brush.Window}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="82" Height="82" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="41">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="36"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       Text="&#xE8BD;" />
                        </Border>
                        <TextBlock Margin="0,19,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Chat.ChooseTitle}" />
                        <TextBlock MaxWidth="420"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="{DynamicResource Chat.ChooseText}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Margin="0,18,0,0"
                                Command="{Binding OpenContactsCommand}"
                                Content="{DynamicResource Chat.OpenContacts}"
                                Style="{StaticResource Button.Primary}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
