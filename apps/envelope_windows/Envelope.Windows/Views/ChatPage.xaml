<UserControl x:Class="Envelope.Windows.Views.ChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Envelope.Windows.Models"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Envelope.Windows;component/Resources/ConversationFilterIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ChatFilterIcon" TargetType="RadioButton" BasedOn="{StaticResource FilterChip}">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </Canvas>
                            </Viewbox>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="14,18,12,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource TextBox.Search}" Tag="{DynamicResource Chat.Search}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Chat.Search}"/>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <Button Grid.Column="1" Margin="5,0,0,0" Content="+" FontSize="23" Padding="0" Command="{Binding OpenContactsCommand}" Style="{StaticResource Button.Quiet}" ToolTip="{DynamicResource Chat.New}"/>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,0,8,12">
                    <RadioButton Content="{StaticResource Icon.Filter.All}" IsChecked="{Binding FilterAll}" GroupName="ConversationFilter" Style="{StaticResource ChatFilterIcon}" ToolTip="{DynamicResource Chat.FilterAll}" AutomationProperties.Name="{DynamicResource Chat.FilterAll}"/>
                    <RadioButton Content="{StaticResource Icon.Filter.Unread}" IsChecked="{Binding FilterUnread}" GroupName="ConversationFilter" Style="{StaticResource ChatFilterIcon}" ToolTip="{DynamicResource Chat.FilterUnread}" AutomationProperties.Name="{DynamicResource Chat.FilterUnread}"/>
                    <RadioButton Content="{StaticResource Icon.Filter.Groups}" IsChecked="{Binding FilterGroups}" GroupName="ConversationFilter" Style="{StaticResource ChatFilterIcon}" ToolTip="{DynamicResource Chat.FilterGroups}" AutomationProperties.Name="{DynamicResource Chat.FilterGroups}"/>
                </StackPanel>
                <Grid Grid.Row="2">
                    <ListBox ItemsSource="{Binding VisibleConversations}"
                             SelectedItem="{Binding SelectedConversation, Mode=TwoWay}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="8,3" />
                                <Setter Property="Padding" Value="10" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Item"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                                    CornerRadius="8">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Item" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Item" Property="BorderBrush" Value="{DynamicResource Brush.Brand}"/>
                                                    <Setter TargetName="Item" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Avatar}">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Accent}"
                                                   Text="{Binding Initials}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="2,0,6,0">
                                        <TextBlock FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   Text="{Binding Preview}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource Brush.TextSubtle}"
                                                   Text="{Binding LastActivity, StringFormat={}{0:t}}" />
                                        <Border MinWidth="20"
                                                Height="20"
                                                Margin="0,6,0,0"
                                                Padding="5,0"
                                                HorizontalAlignment="Right"
                                                Background="#EF4444"
                                                CornerRadius="10">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource Brush.AccentText}"
                                                       Text="{Binding UnreadCount}" />
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UnreadCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasConversations}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock HorizontalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="32"
                                   Foreground="{DynamicResource Brush.TextSubtle}"
                                   Text="&#xE8BD;" />
                        <TextBlock Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Chat.NoConversations}" />
                        <TextBlock MaxWidth="240"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="{DynamicResource Chat.NoConversationsText}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Margin="0,15,0,0"
                                Command="{Binding OpenContactsCommand}"
                                Content="{DynamicResource Chat.OpenContacts}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="68" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="21,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding SelectedConversation.DisplayName}" />
                                <TextBlock Margin="8,1,0,0"
                                           FontFamily="Segoe Fluent Icons"
                                           Foreground="{DynamicResource Brush.Success}"
                                           Text="&#xE73E;">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedConversation.IsVerified}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           FontSize="10"
                                           Foreground="{DynamicResource Brush.Accent}"
                                           Text="&#xE72E;" />
                                <TextBlock Margin="5,0,0,0"
                                           FontSize="10"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           Text="{DynamicResource Chat.EncryptedNotice}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button Margin="0,0,7,0"
                                    Command="{Binding ManageGroupCommand}"
                                    Content="{DynamicResource Chat.ManageGroup}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedConversation.IsGroup}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Margin="0,0,7,0"
                                    Command="{Binding LeaveGroupCommand}"
                                    Content="{DynamicResource Chat.LeaveGroup}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Danger}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedConversation.IsGroup}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Margin="22,14,22,2"
                            Padding="14"
                            Background="{DynamicResource Brush.WarningSoft}"
                            BorderBrush="{DynamicResource Brush.Warning}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Warning}"
                                           Text="{DynamicResource Chat.InvitationTitle}" />
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               Text="{DynamicResource Chat.InvitationText}" />
                                    <TextBlock Margin="6,0,0,0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedConversation.PendingGroupInvitationName}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0" Orientation="Horizontal">
                                <Button Margin="0,0,7,0"
                                        Command="{Binding DeclineInvitationCommand}"
                                        Content="{DynamicResource Chat.DeclineInvitation}" />
                                <Button Command="{Binding AcceptInvitationCommand}"
                                        Content="{DynamicResource Chat.AcceptInvitation}"
                                        Style="{StaticResource Button.Primary}" />
                            </StackPanel>
                        </Grid>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedConversation.HasPendingGroupInvitation}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <ListBox x:Name="MessageList"
                             Grid.Row="1"
                             Padding="24,45,24,16"
                             ItemsSource="{Binding Messages}"
                             SelectionMode="Extended"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Focusable" Value="True" />
                                <Setter Property="Margin" Value="0,4" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Border x:Name="MessageAvatar" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock x:Name="MessageAvatarText" Text="{Binding DataContext.SelectedConversation.Initials, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" FontSize="13"/>
                                    </Border>
                                    <Border x:Name="Bubble"
                                            MaxWidth="520"
                                            Margin="44,0,0,0"
                                            Padding="13,10"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource Brush.MessageOther}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock x:Name="MessageText"
                                                       FontSize="14"
                                                       LineHeight="22"
                                                       Text="{Binding Text}"
                                                       TextWrapping="Wrap" />
                                            <Button Margin="0,8,0,0"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{DynamicResource Chat.OpenAttachment}">
                                                <Border Padding="10,8"
                                                        Background="{DynamicResource Brush.SurfaceAlt}"
                                                        BorderBrush="{DynamicResource Brush.Border}"
                                                        BorderThickness="1"
                                                        CornerRadius="7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE8A5;" />
                                                        <TextBlock Grid.Column="1" FontSize="11" Text="{Binding AttachmentName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2"
                                                                   Margin="12,0,0,0"
                                                                   FontFamily="Segoe Fluent Icons"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource Brush.Accent}"
                                                                   Text="&#xE8A7;" />
                                                    </Grid>
                                                </Border>
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Quiet}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAttachment}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <StackPanel Margin="0,7,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                                <TextBlock x:Name="MessageTime"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource Brush.TextSubtle}"
                                                           Text="{Binding Timestamp, StringFormat={}{0:t}}" />
                                                <TextBlock x:Name="DeliveryGlyph"
                                                           Margin="5,0,0,0"
                                                           FontFamily="Segoe Fluent Icons"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource Brush.TextSubtle}"
                                                           Text="&#xE895;" />
                                                <TextBlock x:Name="DeliveryCaption" Margin="4,0,0,0" FontSize="9"
                                                           Foreground="{DynamicResource Brush.TextSubtle}"
                                                           Text="{DynamicResource Chat.DeliveryPending}" />
                                                <Button Width="20"
                                                        MinHeight="18" Height="18"
                                                        Margin="6,-4,-6,-4"
                                                        Padding="0"
                                                        Command="{Binding DataContext.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Content="&#xE74D;"
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="9"
                                                        Style="{StaticResource Button.Quiet}"
                                                        ToolTip="{DynamicResource Common.Delete}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Direction}" Value="{x:Static models:MessageDirection.Outgoing}">
                                        <Setter TargetName="MessageAvatar" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="MessageAvatarText" Property="Text" Value="{Binding DataContext.ProfileInitial, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Setter TargetName="Bubble" Property="Margin" Value="0,0,44,0" />
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource Brush.MessageMine}" />
                                        <Setter TargetName="Bubble" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                        <Setter TargetName="MessageText" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                        <Setter TargetName="MessageTime" Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                        <Setter TargetName="DeliveryGlyph" Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                        <Setter TargetName="DeliveryCaption" Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Direction}" Value="{x:Static models:MessageDirection.Incoming}">
                                        <Setter TargetName="DeliveryGlyph" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="DeliveryCaption" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DeliveryState}" Value="{x:Static models:MessageDeliveryState.Sent}">
                                        <Setter TargetName="DeliveryCaption" Property="Text" Value="{DynamicResource Chat.DeliverySent}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DeliveryState}" Value="{x:Static models:MessageDeliveryState.Delivered}">
                                        <Setter TargetName="DeliveryCaption" Property="Text" Value="{DynamicResource Chat.DeliveryDelivered}" />
                                        <Setter TargetName="DeliveryGlyph" Property="Text" Value="&#xE73E;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DeliveryState}" Value="{x:Static models:MessageDeliveryState.LegacyUnverified}">
                                        <Setter TargetName="DeliveryCaption" Property="Text" Value="{DynamicResource Chat.DeliveryLegacy}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DeliveryState}" Value="{x:Static models:MessageDeliveryState.Failed}">
                                        <Setter TargetName="DeliveryCaption" Property="Text" Value="{DynamicResource Chat.DeliveryFailed}" />
                                        <Setter TargetName="DeliveryGlyph" Property="Text" Value="&#xE783;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DeliveryState}" Value="{x:Static models:MessageDeliveryState.StagedSingle}">
                                        <Setter TargetName="DeliveryCaption" Property="Text" Value="{DynamicResource Chat.DeliveryStaged}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DeliveryState}" Value="{x:Static models:MessageDeliveryState.Replicated}">
                                        <Setter TargetName="DeliveryCaption" Property="Text" Value="{DynamicResource Chat.DeliveryReplicated}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DeliveryState}" Value="{x:Static models:MessageDeliveryState.Deferred}">
                                        <Setter TargetName="DeliveryCaption" Property="Text" Value="{DynamicResource Chat.DeliveryDeferred}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DeliveryState}" Value="{x:Static models:MessageDeliveryState.Rejected}">
                                        <Setter TargetName="DeliveryCaption" Property="Text" Value="{DynamicResource Chat.DeliveryRejected}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DeliveryState}" Value="{x:Static models:MessageDeliveryState.Expired}">
                                        <Setter TargetName="DeliveryCaption" Property="Text" Value="{DynamicResource Chat.DeliveryExpired}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1"
                                Margin="22,12,22,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Orientation="Horizontal"
                                Panel.ZIndex="2">
                        <Button Margin="0,0,8,0"
                                Command="{Binding LoadEarlierMessagesCommand}"
                                Content="{DynamicResource Chat.LoadEarlier}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Quiet}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasEarlierMessages}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding DeleteSelectedMessagesCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=MessageList}"
                                Content="{DynamicResource Chat.DeleteSelected}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Quiet}">
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedItems.Count, ElementName=MessageList}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasSelection}" Value="True" />
                                            <Condition Binding="{Binding Messages.Count}" Value="0" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock HorizontalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="34"
                                   Foreground="{DynamicResource Brush.TextSubtle}"
                                   Text="&#xE8BD;" />
                        <TextBlock Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Chat.NoMessages}" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="{DynamicResource Chat.NoMessagesText}" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Padding="18,10,18,14" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="100"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                        <StackPanel x:Name="ComposerToolbar" Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Command="{Binding AttachFileCommand}" Content="&#xE898;" Style="{StaticResource Button.Icon}" ToolTip="{DynamicResource Chat.AttachFile}"/>
                            <Button Command="{Binding SealCommand}" Style="{StaticResource Button.Quiet}" Margin="10,0,0,0" Height="38" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE715;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource Chat.SealOffline}"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBox x:Name="Composer" Grid.Row="1" Margin="0,6,0,6" AcceptsReturn="True" IsEnabled="{Binding HasSelection}"
                                 PreviewKeyDown="Composer_PreviewKeyDown" Tag="{DynamicResource Chat.MessagePlaceholder}"
                                 Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{DynamicResource Chat.ComposerHint}" Foreground="{DynamicResource Brush.TextSubtle}" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <Button MinWidth="80" Command="{Binding SendCommand}" Content="{DynamicResource Chat.Send}" Style="{StaticResource Button.Primary}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.RowSpan="3" Background="{DynamicResource Brush.Window}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="82" Height="82" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="41">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="36"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       Text="&#xE8BD;" />
                        </Border>
                        <TextBlock Margin="0,19,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Chat.ChooseTitle}" />
                        <TextBlock MaxWidth="420"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="{DynamicResource Chat.ChooseText}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Margin="0,18,0,0"
                                Command="{Binding OpenContactsCommand}"
                                Content="{DynamicResource Chat.OpenContacts}"
                                Style="{StaticResource Button.Primary}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
