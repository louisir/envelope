<UserControl x:Class="Envelope.Windows.Views.ContactsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="34,28,34,34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="{DynamicResource Contacts.Title}" />
                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.PageSubtitle}" Text="{DynamicResource Contacts.Subtitle}" />
                    <TextBlock Margin="12,4,0,0" Style="{StaticResource Text.PageSubtitle}">
                        <Run Text="· " />
                        <Run Text="{Binding ContactCount, Mode=OneWay}" />
                        <Run Text=" / " />
                        <Run Text="{Binding GroupCount, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <Button Margin="0,0,9,0" Command="{Binding CreateGroupCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE902;" />
                        <TextBlock Text="{DynamicResource Contacts.CreateGroup}" />
                    </StackPanel>
                </Button>
                <Button x:Name="AddContactMenuButton"
                        Click="OpenContactMenu_Click"
                        Style="{StaticResource Button.Primary}">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Command="{Binding ShowQrCommand}" Header="{DynamicResource Contacts.ShowQr}" />
                            <MenuItem Command="{Binding ScanQrCommand}" Header="{DynamicResource Contacts.ImportScanResult}" />
                            <MenuItem Command="{Binding PasteContactCommand}" Header="{DynamicResource Contacts.PasteContact}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE8FA;" />
                        <TextBlock Text="{DynamicResource Contacts.AddContact}" />
                        <TextBlock Margin="9,0,0,0" FontFamily="Segoe Fluent Icons" FontSize="9" Text="&#xE70D;" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,23,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid MaxWidth="520" HorizontalAlignment="Left">
                <TextBlock Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Panel.ZIndex="1"
                           FontFamily="Segoe Fluent Icons"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           IsHitTestVisible="False"
                           Text="&#xE721;" />
                <TextBox Width="420"
                         Style="{StaticResource TextBox.Search}"
                         Tag="{DynamicResource Contacts.Search}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton Command="{Binding SetFilterCommand}"
                             CommandParameter="All"
                             Content="{DynamicResource Contacts.FilterAll}"
                             IsChecked="{Binding IsAllFilter, Mode=OneWay}"
                             Style="{StaticResource FilterChip}" />
                <RadioButton Command="{Binding SetFilterCommand}"
                             CommandParameter="Direct"
                             Content="{DynamicResource Contacts.FilterDirect}"
                             IsChecked="{Binding IsDirectFilter, Mode=OneWay}"
                             Style="{StaticResource FilterChip}" />
                <RadioButton Command="{Binding SetFilterCommand}"
                             CommandParameter="Groups"
                             Content="{DynamicResource Contacts.FilterGroups}"
                             IsChecked="{Binding IsGroupsFilter, Mode=OneWay}"
                             Style="{StaticResource FilterChip}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" MinWidth="330" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="5*" MinWidth="390" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <ListBox ItemsSource="{Binding FilteredItems}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="8,4" />
                            <Setter Property="Padding" Value="12" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Container"
                                                Padding="{TemplateBinding Padding}"
                                                Background="Transparent"
                                                CornerRadius="10">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Container" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Container" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Avatar}">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Accent}"
                                               Text="{Binding Initials}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="2,1,8,0">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               Text="{Binding Subtitle}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="2"
                                        MinWidth="22"
                                        Height="22"
                                        Padding="6,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.Accent}"
                                        CornerRadius="11">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               Foreground="{DynamicResource Brush.AccentText}"
                                               Text="{Binding UnreadCount}" />
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UnreadCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="40"
                                   Foreground="{DynamicResource Brush.TextSubtle}"
                                   Text="&#xE716;" />
                        <TextBlock Margin="0,16,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Contacts.DetailEmptyTitle}" />
                        <TextBlock MaxWidth="340"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="{DynamicResource Contacts.DetailEmptyText}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="70" Height="70" CornerRadius="35" Background="{DynamicResource Brush.AccentSoft}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Accent}"
                                           Text="{Binding SelectedItem.Initials}" />
                            </Border>
                            <TextBlock Margin="0,14,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedItem.DisplayName}" />
                            <TextBlock Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       Text="{Binding SelectedItem.Subtitle}" />
                            <Border Margin="0,20,0,0" Style="{StaticResource Divider}" />
                            <TextBlock Margin="0,18,0,0" Style="{StaticResource Text.Caption}" Text="{DynamicResource Contacts.Fingerprint}" />
                            <TextBlock Margin="0,5,0,0"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Text="{Binding SelectedItem.Fingerprint}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Caption}" Text="{DynamicResource Contacts.KeyId}" />
                            <TextBlock Margin="0,5,0,0"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Text="{Binding SelectedItem.KeyId}"
                                       TextWrapping="Wrap" />
                            <Border Margin="0,18,0,0" Padding="12" Background="{DynamicResource Brush.WarningSoft}" CornerRadius="8">
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource Brush.Warning}"
                                           Text="{DynamicResource Contacts.SafetyTip}"
                                           TextWrapping="Wrap" />
                            </Border>
                            <Button Margin="0,20,0,0"
                                    Command="{Binding OpenChatCommand}"
                                    Style="{StaticResource Button.Primary}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE8BD;" />
                                    <TextBlock Text="{DynamicResource Contacts.OpenChat}" />
                                </StackPanel>
                            </Button>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Command="{Binding EditCommand}" Content="{DynamicResource Common.Edit}" />
                                <Button Grid.Column="2" Command="{Binding DeleteCommand}" Content="{DynamicResource Common.Delete}" Style="{StaticResource Button.Danger}" />
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem.IsGroup}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                            </Grid>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Command="{Binding ManageGroupCommand}" Content="{DynamicResource Contacts.ManageGroup}" />
                                <Button Grid.Column="2"
                                        Command="{Binding LeaveGroupCommand}"
                                        Content="{DynamicResource Contacts.LeaveGroup}"
                                        Style="{StaticResource Button.Danger}" />
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem.IsGroup}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.ColumnSpan="3" Background="{DynamicResource Brush.Window}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="78" Height="78" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="39">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="34"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   Text="&#xE716;" />
                    </Border>
                    <TextBlock Margin="0,18,0,0"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="{DynamicResource Contacts.EmptyTitle}" />
                    <TextBlock MaxWidth="460"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               Text="{DynamicResource Contacts.EmptyText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <StackPanel Margin="0,21,0,0" Orientation="Horizontal">
                        <Button Margin="0,0,8,0" Command="{Binding ShowQrCommand}" Content="{DynamicResource Contacts.ShowQr}" Style="{StaticResource Button.Primary}" />
                        <Button Margin="0,0,8,0" Command="{Binding ScanQrCommand}" Content="{DynamicResource Contacts.ScanQr}" />
                        <Button Command="{Binding PasteContactCommand}" Content="{DynamicResource Contacts.PasteContact}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
