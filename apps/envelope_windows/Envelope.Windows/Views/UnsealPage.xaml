<UserControl x:Class="Envelope.Windows.Views.UnsealPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             AllowDrop="True"
             DragEnter="OnDragEnter"
             Drop="OnDrop"
             mc:Ignorable="d">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1060" Margin="38,32,38,44" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource Text.PageTitle}" Text="{DynamicResource Unseal.Title}" />
                <TextBlock Style="{StaticResource Text.PageSubtitle}" Text="{DynamicResource Unseal.Subtitle}" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,25,0,0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="94" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="72" Height="72" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="18">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="31"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   Text="&#xE8E5;" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="0,2,24,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{DynamicResource Unseal.FileTitle}" />
                        <TextBlock Margin="0,7,0,0"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   LineHeight="20"
                                   Text="{DynamicResource Unseal.FileText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,7,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.TextSubtle}"
                                   Text="{DynamicResource Unseal.DropHint}" />
                        <TextBlock Margin="0,7,0,0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   Text="{Binding SelectedFileName}" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            MinWidth="150"
                            VerticalAlignment="Center"
                            Command="{Binding ChooseFileCommand}"
                            Style="{StaticResource Button.Primary}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE8E5;" />
                            <TextBlock Text="{DynamicResource Unseal.ChooseFile}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="0,18,0,0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{DynamicResource Unseal.ClipboardTitle}" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       Text="{DynamicResource Unseal.ClipboardText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Margin="18,0,0,0"
                                Command="{Binding PasteCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE77F;" />
                                <TextBlock Text="{DynamicResource Unseal.Paste}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Grid.Row="1"
                               Margin="0,18,0,7"
                               Style="{StaticResource Text.Caption}"
                               Text="{DynamicResource Unseal.Base64Label}" />
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox MinHeight="150"
                                 MaxHeight="260"
                                 AcceptsReturn="True"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 HorizontalScrollBarVisibility="Auto"
                                 Tag="{DynamicResource Unseal.Base64Hint}"
                                 Text="{Binding EnvelopeBase64, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 ToolTip="{DynamicResource Unseal.Base64Hint}"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" />
                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           Foreground="{DynamicResource Brush.Warning}"
                                           Text="&#xE72E;" />
                                <TextBlock Margin="7,0,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource Brush.Warning}"
                                           Text="{DynamicResource Unseal.IdentityRequired}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IdentityReady}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    MinWidth="145"
                                    Command="{Binding OpenTextCommand}"
                                    Style="{StaticResource Button.Primary}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE785;" />
                                    <TextBlock Text="{DynamicResource Unseal.Open}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card.Accent}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontFamily="Segoe Fluent Icons"
                                   FontSize="25"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   Text="&#xE72E;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Text.CardTitle}" Text="{DynamicResource Unseal.SecurityTitle}" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       LineHeight="19"
                                       Text="{DynamicResource Unseal.SecurityText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card.Quiet}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="{DynamicResource Unseal.RecentTitle}" />
                        <ItemsControl Margin="0,11,0,0" ItemsSource="{Binding RecentEnvelopes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5,0,7">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Sender}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   Text="{Binding Summary}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="{DynamicResource Unseal.RecentEmpty}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRecentEnvelopes}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
