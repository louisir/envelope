<Window x:Class="Envelope.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding About.FullVersion, StringFormat=Envelope {0}}" Icon="Resources/AppIcon.png"
        Width="1200" Height="800" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}" FontFamily="Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="WindowFrame" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="Minimize_Click" Content="&#xE921;" Style="{StaticResource Button.Window}" ToolTip="{DynamicResource Shell.Minimize}"/>
                        <Button Click="MaximizeRestore_Click" Content="&#xE922;" Style="{StaticResource Button.Window}" ToolTip="{DynamicResource Shell.Maximize}"/>
                        <Button Click="Close_Click" Content="&#xE8BB;" Style="{StaticResource Button.WindowClose}" ToolTip="{DynamicResource Shell.HideToTray}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                        <Image Source="Resources/AppIcon.png" Width="22" Height="22"/>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Margin="9,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid x:Name="Workspace" Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Top" Click="Profile_Click" Margin="10,18,10,18" Padding="0" Width="44" Height="44"
                                ToolTip="{DynamicResource Settings.IdentitySection}" Style="{StaticResource Button.Quiet}">
                            <Border Background="{DynamicResource Brush.Brand}" CornerRadius="22" Width="42" Height="42">
                                <TextBlock Text="{Binding ProfileInitial}" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>
                        <StackPanel DockPanel.Dock="Bottom" Margin="8,8,8,12">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="16" HorizontalAlignment="Center" Margin="0,8" ToolTip="{Binding StatusText}" Foreground="{DynamicResource Brush.TextMuted}"/>
                            <Button Click="Lock_Click" Content="&#xE72E;" Style="{StaticResource Button.Icon}" ToolTip="{DynamicResource Tray.Lock}" Margin="0,4"/>
                            <Button Click="Settings_Click" Content="&#xE713;" Style="{StaticResource Button.Icon}" ToolTip="{DynamicResource Nav.Settings}" Margin="0,4"/>
                            <Button Click="About_Click" Content="&#xE897;" Style="{StaticResource Button.Icon}" ToolTip="{DynamicResource Nav.About}" Margin="0,4"/>
                        </StackPanel>
                        <Grid>
                            <ListBox ItemsSource="{Binding PrimaryNavigationItems}" SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" VerticalAlignment="Top" ItemContainerStyle="{StaticResource NavigationItem}">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="23" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <Border Background="#EF4444" CornerRadius="10" MinWidth="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,4,0" IsHitTestVisible="False"
                                    Visibility="{Binding HasUnread, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding UnreadBadge}" FontSize="10" Foreground="White" Margin="4,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>
                <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>
                <ProgressBar Grid.Column="1" Height="2" VerticalAlignment="Top" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
