<Window x:Class="Envelope.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="{DynamicResource App.WindowTitle}"
        Width="1280"
        Height="820"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Brush.Window}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Brush.BorderStrong}"
            BorderThickness="1"
            Background="{DynamicResource Brush.Window}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2" Background="{DynamicResource Brush.Sidebar}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="78" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="20,14,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42"
                                Height="42"
                                Background="{DynamicResource Brush.Accent}"
                                CornerRadius="11">
                            <Grid>
                                <Path Width="24"
                                      Height="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 1,2 L 12,10 L 23,2 M 2,3 L 2,17 L 22,17 L 22,3"
                                      Stretch="Fill"
                                      Stroke="{DynamicResource Brush.AccentText}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <Border Width="8"
                                        Height="8"
                                        Margin="0,0,3,3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource Brush.Sidebar}"
                                        BorderBrush="{DynamicResource Brush.AccentText}"
                                        BorderThickness="1.5"
                                        CornerRadius="4" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,1,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.SidebarText}"
                                       Text="{DynamicResource App.Name}" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource Brush.SidebarMuted}"
                                       Text="{DynamicResource App.Tagline}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Height="1"
                            Margin="18,0"
                            Background="{DynamicResource Brush.SidebarSelected}" />

                    <ListBox Grid.Row="2"
                             Margin="0,14,0,0"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource NavigationItem}"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="17"
                                               Foreground="{DynamicResource Brush.SidebarText}"
                                               Text="{Binding Glyph}" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.SidebarText}"
                                               Text="{Binding Title}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="3"
                            Margin="14,10,14,16"
                            Padding="12"
                            Background="{DynamicResource Brush.SidebarHover}"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8"
                                     Height="8"
                                     Margin="0,4,10,0"
                                     VerticalAlignment="Top"
                                     Fill="{DynamicResource Brush.Accent}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource Brush.SidebarText}"
                                           Text="{Binding StatusText}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,5,0,0"
                                           FontSize="10"
                                           Foreground="{DynamicResource Brush.SidebarMuted}"
                                           Text="{DynamicResource App.PrivacyNote}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Grid.Row="0"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="18,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="13"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   Text="&#xE72E;" />
                        <TextBlock Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="{DynamicResource App.PrivacyNote}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="Minimize_Click"
                                Content="&#xE921;"
                                Style="{StaticResource Button.Window}"
                                ToolTip="{DynamicResource Shell.Minimize}" />
                        <Button Click="MaximizeRestore_Click"
                                Content="&#xE922;"
                                Style="{StaticResource Button.Window}"
                                ToolTip="{DynamicResource Shell.Maximize}" />
                        <Button Click="Close_Click"
                                Content="&#xE8BB;"
                                Style="{StaticResource Button.WindowClose}"
                                ToolTip="{DynamicResource Shell.Close}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Grid.Row="1" Background="{DynamicResource Brush.Window}">
                <ContentControl Content="{Binding CurrentPage}" />
                <ProgressBar Height="2"
                             VerticalAlignment="Top"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </Border>
</Window>
