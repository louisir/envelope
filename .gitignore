# Android native libraries generated from Rust FFI
**/android/app/src/main/jniLibs/**/*.so

# Signing material
**/key.properties
**/android/signing/
**/*.jks
**/*.keystore
**/*.p12
**/*.pfx
**/*-private.pem

# Local server runtime / deployment overrides
/envelope-server.sqlite3*
/deploy/envelope-server/*.env
!/deploy/envelope-server/*.env.example

# Local release bundles / generated packages
/target/portable/
