# ENVELOPE_SERVER_MANIFEST_PUBLIC_KEY=<base64url-ed25519-public-key>
# ENVELOPE_SERVER_NODE_ID=<node-id-in-manifest>
# ENVELOPE_SERVER_NODE_SIGNING_SECRET_FILE=/etc/envelope-server/node-signing-secret
