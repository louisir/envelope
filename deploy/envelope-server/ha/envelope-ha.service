[Unit]
Description=Envelope HA v2 relay
Wants=network-online.target
After=network-online.target envelope-etcd.service envelope-ha-firewall.service
Requires=envelope-ha-firewall.service

[Service]
Type=simple
User=envelope
Group=envelope
ExecStart=/opt/envelope-ha/current/envelope-server-ha --config /etc/envelope-ha/runtime.json
WorkingDirectory=/var/lib/envelope-ha
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
LimitNOFILE=65536
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/envelope-ha

[Install]
WantedBy=multi-user.target
